---
import type { Content, Page } from "../lib/types";
import { existsSync } from "node:fs";
import { sources } from "../lib/image";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props { content: Content; page?: Page; title?: string; noindex?: boolean }
const { content, page, title: forced, noindex = page?.seo?.noindex ?? false } = Astro.props;
const { settings } = content;
const siteUrl = (settings.siteUrl || Astro.site?.toString() || "").replace(/\/$/, "");
const slug = page?.slug?.current ?? "";
const path = slug ? `/${slug}/` : "/";
const isHome = page && !slug;
const pageTitle = forced ?? page?.seo?.title ?? page?.title;
const title = isHome || !pageTitle ? settings.seo.title : `${pageTitle} — ${settings.siteName}`;
const description = page?.seo?.description ?? settings.seo.description;
const og = sources(page?.seo?.ogImage ?? settings.seo.ogImage, [1200]);
const ogImage = og ? (og.fallback.startsWith("http") ? og.fallback : `${siteUrl}${og.fallback}`) : undefined;
// styles.css y los scripts no llevan hash; el id del commit rompe la caché larga (ver netlify.toml).
const v = (process.env.COMMIT_REF || String(Date.now())).slice(0, 8);
// Hoja propia de la página (public/css/pagina-<slug>.css), solo si existe.
const pageCss = slug && existsSync(`public/css/pagina-${slug}.css`) ? `/css/pagina-${slug}.css?v=${v}` : null;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: settings.siteName,
  description: settings.seo.description,
  inLanguage: "es",
}).replace(/</g, "\\u003c");
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#ffffff">
{!noindex && <link rel="canonical" href={`${siteUrl}${path}`}>}
<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">

<meta property="og:type" content="website">
<meta property="og:locale" content="es_CO">
<meta property="og:site_name" content={settings.siteName}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={`${siteUrl}${path}`}>
{ogImage && <meta property="og:image" content={ogImage}>}
{og && <meta property="og:image:width" content={String(og.width)}>}
{og && <meta property="og:image:height" content={String(og.height)}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{ogImage && <meta name="twitter:image" content={ogImage}>}

<link rel="preload" href="/assets/fonts/XanhMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/SchibstedGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={`/css/styles.css?v=${v}`}>
{pageCss && <link rel="stylesheet" href={pageCss}>}
<script is:inline>
  // Antes de pintar: marca que hay JS y mide el ancho útil (sin barra de scroll) para la escala fluida.
  (function (d) { d.classList.add("js"); var f = function () { d.style.setProperty("--vw", d.clientWidth + "px"); }; f(); addEventListener("resize", f); })(document.documentElement);
</script>
<script defer src={`/js/main.js?v=${v}`}></script>
<slot name="head" />
{!noindex && isHome && <script type="application/ld+json" is:inline set:html={jsonLd}></script>}
</head>
<body class:list={[`dots-${page?.dots ?? "amplio"}`, page && `page-${slug || "inicio"}`]}>
<a class="skip" href="#contenido">{settings.labels.skip}</a>
<Header settings={settings} page={page} />
<main id="contenido">
  <slot />
</main>
<Footer settings={settings} page={page} />
</body>
</html>

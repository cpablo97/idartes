---
// Netlify sirve dist/404.html para las direcciones que no existen.
import Base from "../layouts/Base.astro";
import { getContent } from "../lib/content";
const content = await getContent();
const { settings } = content;
---
<Base content={content} title="Página no encontrada" noindex>
  <section class="notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1 class="display" style="color:var(--rojo)">esta calle<br><em>no existe.</em></h1>
    <p>La dirección que buscas no está en el mapa. Puedes volver al inicio o seguir por alguno de estos caminos:</p>
    <ul>
      {settings.menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}
    </ul>
  </section>
</Base>
